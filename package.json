{
  "name": "eatswada-backend",
  "version": "1.0.0",
  "description": "Production backend for Eatswada food delivery app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seeder.js",
    "test:syntax": "node tests/syntax-check.js",
    "test:launch-gate": "node tests/launch-gate.js",
    "test:integration": "node tests/integration-gate.js",
    "test:e2e:order": "node tests/order-lifecycle-e2e.js",
    "test:security": "node tests/security-gate.js",
    "test:deployment": "node tests/deployment-gate.js",
    "audit:deps": "npm audit --audit-level=high",
    "outdated:deps": "npm outdated",
    "test:payment-security": "node tests/payment-security.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.0",
    "xss-clean": "^0.1.4",
    "express-async-handler": "^1.2.0",
    "hpp": "^0.2.3",
    "compression": "^1.8.1",
    "cloudinary": "^2.7.0",
    "multer": "^2.2.0",
    "streamifier": "^0.1.1",
    "axios": "^1.18.0",
    "twilio": "^5.4.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
